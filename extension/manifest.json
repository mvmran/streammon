{
  "manifest_version": 3,
  "name": "Stream Audio Monitor",
  "version": "1.1.6",
  "description": "Monitors a YouTube stream's audio as viewers hear it: loudness, true peak and clipping below 0 dBFS.",
  "homepage_url": "https://github.com/mvmran/streammon",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "sidePanel",
    "scripting",
    "notifications",
    "declarativeContent"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Monitor this YouTube tab's audio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
